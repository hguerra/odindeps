{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "odindeps manifest",
  "description": "Declares direct Git and local path dependencies materialized by odindeps.",
  "type": "object",
  "required": [
    "schema_version",
    "dependencies"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "dependencies": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/git_dependency"
          },
          {
            "$ref": "#/$defs/path_dependency"
          }
        ]
      }
    },
    "defaults": {
      "$ref": "#/$defs/options"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "git_dependency": {
      "type": "object",
      "required": [
        "git",
        "rev"
      ],
      "properties": {
        "git": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*://)(?!.*[@?#\\\\])(?!.*[\\u0000-\\u001F\\u007F])(?!.*(?:^|/)\\.\\.?(?:/|$))(?:[^/]+/){2,}[^/]+$",
          "description": "Transport-neutral host/owner/repository Git locator."
        },
        "rev": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!-)(?!.*[\\u0000-\\u001F\\u007F]).+$"
        },
        "options": {
          "$ref": "#/$defs/git_dependency_options"
        }
      },
      "additionalProperties": false
    },
    "path_dependency": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_control_string"
        },
        "options": {
          "$ref": "#/$defs/path_dependency_options"
        }
      },
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "properties": {
        "destination_root": {
          "$ref": "#/$defs/portable_path"
        },
        "transport": {
          "enum": [
            "https",
            "ssh"
          ]
        },
        "git": {
          "$ref": "#/$defs/git_options"
        },
        "cache": {
          "$ref": "#/$defs/cache_options"
        },
        "local": {
          "$ref": "#/$defs/local_options"
        }
      },
      "additionalProperties": false
    },
    "git_dependency_options": {
      "type": "object",
      "properties": {
        "destination_root": {
          "$ref": "#/$defs/portable_path"
        },
        "transport": {
          "enum": [
            "https",
            "ssh"
          ]
        },
        "git": {
          "$ref": "#/$defs/git_options"
        },
        "cache": {
          "$ref": "#/$defs/cache_options"
        }
      },
      "additionalProperties": false
    },
    "path_dependency_options": {
      "type": "object",
      "properties": {
        "destination_root": {
          "$ref": "#/$defs/portable_path"
        },
        "local": {
          "$ref": "#/$defs/local_options"
        }
      },
      "additionalProperties": false
    },
    "git_options": {
      "type": "object",
      "properties": {
        "strategy": {
          "enum": [
            "clone",
            "submodule",
            "subtree"
          ]
        },
        "clone": {
          "type": "object",
          "properties": {
            "includes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "excludes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "subtree": {
          "type": "object",
          "properties": {
            "squash": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cache_options": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "off",
            "symlink"
          ]
        },
        "directory": {
          "$ref": "#/$defs/non_control_string"
        }
      },
      "additionalProperties": false
    },
    "local_options": {
      "type": "object",
      "properties": {
        "strategy": {
          "enum": [
            "copy",
            "symlink"
          ]
        }
      },
      "additionalProperties": false
    },
    "portable_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
      "description": "Portable project-relative path using forward slashes."
    },
    "non_control_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*[\\u0000-\\u001F\\u007F]).+$"
    }
  }
}
